# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
WAREHOUSE_DB=warehouse
AIRFLOW_DB=airflow

# Kafka Configuration
KAFKA_BROKER=kafka:9092
KAFKA_EXTERNAL_PORT=29092
KAFKA_TOPIC=orders.events

# Airflow Configuration
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=False
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Agent / LLM Configuration (Optional - offline rule-based fallback active if keys not set)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=AIza...
LLM_PROVIDER=auto

# dbt Warehouse Targets (postgres default, bigquery optional)
DBT_TARGET=postgres
DBT_HOST=postgres
DBT_PORT=5432
DBT_USER=postgres
DBT_PASSWORD=postgres
DBT_DATABASE=warehouse
DBT_SCHEMA=analytics

# Optional BigQuery target credentials
GCP_PROJECT_ID=praxis-data-project
GCP_DATASET=analytics
GCP_KEYFILE_PATH=/opt/airflow/gcp-key.json
